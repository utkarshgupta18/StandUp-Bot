# Copy this file to .env and fill in your key
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Optional overrides
CLAUDE_MODEL=claude-opus-5-5
# Thinking depth / spend: low | medium | high | xhigh | max (empty = don't send)
CLAUDE_EFFORT=medium
# Server-side refusal fallback for models that support it (true/false)
CLAUDE_REFUSAL_FALLBACK=true
EMBEDDING_MODEL=all-MiniLM-L6-v2
DATA_DIR=./data

# Phase 2: re-ingest every project on a schedule (minutes, 0 = off)
REINGEST_INTERVAL_MINUTES=0

# Phase 3: structured status generation
# Regenerate a project's status after a re-ingestion run that found changes
STATUS_AUTO_GENERATE=true
STATUS_MAX_COMMITS=30
STATUS_MAX_DOC_CHARS=20000

# Streamlit UI: where the API lives
STANDUP_API_URL=http://localhost:8000

# ---------------------------------------------------------------- Phase 4
# Storage: leave empty for SQLite + local Chroma under DATA_DIR. For Postgres
# (docker-compose sets these for you):
# DATABASE_URL=postgresql://standup:standup@localhost:5432/standup
# VECTOR_BACKEND=pgvector        # chroma (default) | pgvector
# PGVECTOR_URL=                  # defaults to DATABASE_URL

# Auth: off by default. When on, everything except /health needs a login.
AUTH_ENABLED=false
# Long random string; tokens are signed with it (python -c "import secrets; print(secrets.token_urlsafe(48))")
AUTH_SECRET=
AUTH_TOKEN_TTL_HOURS=168
# Creates the first admin on startup if there are no users yet
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Only needed if a browser app on another origin calls the API directly
CORS_ORIGINS=
# Streamlit UI with auth on: python -m app.manage create-token <user>
STANDUP_API_TOKEN=

# Connectors (add sources per project in the UI or via POST /projects/{id}/sources)
SLACK_BOT_TOKEN=
LINEAR_API_KEY=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
NOTION_TOKEN=
# Max connector items (issues, Slack days, pages) included in a status prompt
STATUS_MAX_ITEMS=40
